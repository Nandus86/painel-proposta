# Certificado HTTPS automático (Let's Encrypt) para o domínio do painel.
# O DNS de APP_DOMAIN precisa apontar para o IP desta VPS antes de subir.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:80
}
