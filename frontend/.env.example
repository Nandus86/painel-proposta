# Variáveis do Vite (embutidas no build). Em produção são passadas como build args pelo docker-compose.
# Deixe VITE_API_URL vazio quando o nginx do frontend faz proxy de /api (padrão).
VITE_API_URL=
VITE_APP_NAME=Dekto
VITE_ROOT_DOMAIN=dekto.com

# Links opcionais exibidos no cadastro (se definidos, o aceite passa a ser obrigatório)
VITE_TERMS_URL=
VITE_PRIVACY_URL=
