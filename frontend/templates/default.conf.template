# Gerado a partir deste template na subida do container (envsubst do nginx:alpine).
# Variáveis: ${BACKEND_UPSTREAM} (host:porta da API) e ${SERVER_NAME}.

# --- IP real do cliente quando há outro proxy na frente (Caddy/Traefik/Cloudflare na rede privada) ---
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Preserva o protocolo original (https) quando o TLS termina num proxy anterior
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# --- Rate limiting (proteção contra força bruta e abuso das rotas públicas) ---
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=public_limit:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_req_status 429;

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml application/json image/svg+xml;

    # Upload de logo (a API limita a 5 MB) e importação de CSV
    client_max_body_size 6m;

    # Docker DNS: resolve o backend a cada requisição (nginx sobe mesmo com a API fora do ar)
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://${BACKEND_UPSTREAM};

    # Cabeçalhos repassados para a API
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Connection "";

    # Segurança
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /api/health {
        access_log off;
        proxy_pass $backend;
    }

    # Login, cadastro, refresh e senha: limite estrito por IP
    location ~ ^/api/auth/(login|register|refresh|esqueci-senha|redefinir-senha|alterar-senha)$ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass $backend;
    }

    # Links públicos enviados aos clientes
    location /api/public/ {
        limit_req zone=public_limit burst=30 nodelay;
        proxy_pass $backend;
    }

    location /api/ {
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass $backend;
        # Geração com IA e PDF podem demorar
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /uploads/ {
        # nosniff já vem do bloco server; a CSP restritiva vem da API
        proxy_pass $backend;
        proxy_hide_header X-Content-Type-Options;
        expires 1d;
    }

    # Assets com hash no nome: cache longo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: qualquer outra rota cai no index.html (nunca em cache, para pegar deploys novos)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
