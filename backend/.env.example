# Desenvolvimento local (para produção use o .env.example da raiz do projeto)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/painel_proposta
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/painel_proposta

# Em desenvolvimento uma chave padrão é usada se ficar vazia
SECRET_KEY=

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_NAME=Dekto
BASE_DOMAIN=dekto.com
LOG_LEVEL=INFO

# IA (fallback se o OpenRouter não estiver configurado pelo superadmin)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage: local por padrão
STORAGE_PROVIDER=local
