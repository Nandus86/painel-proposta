# =====================================================================
#  Painel de Propostas — configuração de produção
#  Copie para .env e preencha:  cp .env.example .env
#  NUNCA versione o arquivo .env.
# =====================================================================

# ---------- Domínio / marca ----------
APP_NAME=Dekto
# Domínio onde o painel será acessado (sem https://). Usado pelo Caddy para emitir o certificado.
APP_DOMAIN=app.seudominio.com.br
# URL pública completa do painel: vai nos links enviados aos clientes por e-mail/WhatsApp
FRONTEND_URL=https://app.seudominio.com.br
# Origem(ns) permitidas para CORS (separe por vírgula). Normalmente igual à FRONTEND_URL.
CORS_ORIGINS=https://app.seudominio.com.br
# Domínio raiz usado nos subdomínios das empresas (ex.: empresa.seudominio.com.br)
BASE_DOMAIN=seudominio.com.br
# true = links públicos usam o subdomínio/domínio próprio da empresa
# (exige DNS wildcard *.BASE_DOMAIN e certificado wildcard; deixe false se não configurou)
PUBLIC_LINKS_USE_TENANT_DOMAIN=false
# Porta/endereço em que o container do frontend escuta no host.
# Sem Caddy: 80   |   Com o perfil https (Caddy): 127.0.0.1:8080
FRONTEND_BIND=80
# Links dos seus Termos de Uso e Política de Privacidade (opcionais).
# Quando preenchidos, o cadastro passa a exigir o aceite.
TERMS_URL=
PRIVACY_URL=

# ---------- Segurança ----------
# Gere com:  openssl rand -hex 32
# ATENÇÃO: esta chave também criptografa as senhas SMTP e tokens salvos no banco.
# Guarde-a em local seguro e NÃO a troque depois de entrar em produção.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Banco de dados ----------
POSTGRES_USER=painel
# Use apenas letras e números (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=
POSTGRES_DB=painel_proposta

# ---------- API ----------
# Processos do uvicorn (regra prática: 2 x núcleos de CPU, máx. 4 numa VPS pequena)
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
MAX_UPLOAD_MB=5

# ---------- E-mail do sistema (recomendado) ----------
# Usado para recuperação de senha, boas-vindas e avisos aos vendedores (proposta aceita).
# Sem isso, "Esqueci minha senha" fica indisponível. Porta 465 = SSL; 587 = STARTTLS.
# Serviços transacionais funcionam bem aqui: Amazon SES, Brevo, Resend, Mailgun, SendGrid...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente (padrão: SMTP_USER). Ex.: naoresponda@seudominio.com.br
SMTP_FROM=
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---------- Rotinas automáticas ----------
# Marca propostas/orçamentos enviados como vencidos e avisa quando faltam N dias para vencer
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=60
AVISO_VENCIMENTO_DIAS=3

# ---------- IA (opcional) ----------
# A chave do OpenRouter pode ser configurada pela tela do Super Admin (recomendado).
# Estas variáveis são o fallback caso nenhuma chave esteja configurada lá.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Armazenamento de arquivos (opcional) ----------
# Padrão: disco local (volume "uploads"). Para usar MinIO/S3, preencha as variáveis abaixo.
STORAGE_PROVIDER=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=painel-proposta
MINIO_SECURE=true
MINIO_PUBLIC_URL=
